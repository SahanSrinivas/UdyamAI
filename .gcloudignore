# Files gcloud will not upload as build context.
# Without this file gcloud falls back to .gitignore, which does not exclude
# .git and would push ~100 MB of history on every deploy.
.git
.gitignore
node_modules
.next
.data
.env
.env.local
.env.production
*.log
*.pptx
deck-screenshots
__pycache__
*.pyc
tsconfig.tsbuildinfo
